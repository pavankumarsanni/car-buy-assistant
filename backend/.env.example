# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-opus-4-6
USE_MOCK_DATA=true
DEBUG=false
LOG_LEVEL=INFO

# ── CORS (comma-separated) ────────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── External vehicle API (when USE_MOCK_DATA=false) ───────────────────────────
# VEHICLE_API_BASE_URL=https://api.example-cars.com/v1
# VEHICLE_API_KEY=your-key-here

# ── CRM Webhook ───────────────────────────────────────────────────────────────
# CRM_WEBHOOK_URL=https://hooks.example.com/car-leads
